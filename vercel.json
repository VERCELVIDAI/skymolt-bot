{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/index.ts",
      "bindings": [
        {
          "type": "service",
          "service": "web",
          "format": "url",
          "env": "WEB_URL"
        }
      ]
    },
    "www": {
      "root": "apps/www",
      "framework": "astro",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/rpc/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/rpc",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
